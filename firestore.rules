rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Schools: anyone can read, authenticated users can create/edit/delete
    match /schools/{schoolId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Issues: authenticated users can create and read, authenticated users can update status
    match /issues/{issueId} {
      allow read, create: if request.auth != null;
      allow update: if request.auth != null;
    }

    // Activity log: server-side writes only (authenticated), no client reads
    match /activityLog/{logId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

    // Users: each user can write their own doc, no client reads
    match /users/{userId} {
      allow write: if request.auth != null && request.auth.uid == userId;
      allow read: if false;
    }
  }
}
